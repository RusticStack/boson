# Generates the terminal demo's asset header (cmake -P). MSVC has no #embed yet, so the bundle becomes constexpr
# byte arrays the same way cmake/EmbedAssets.cmake embeds frontend/dist.
#   cmake -DOUT=<header> -DASSETS=<url>=<file>,<url>=<file>,... -P embed_assets.cmake
string(REPLACE "," ";" _assets "${ASSETS}")
set(_arrays "")
set(_entries "")
set(_index 0)
foreach(_pair IN LISTS _assets)
    string(FIND "${_pair}" "=" _eq)
    string(SUBSTRING "${_pair}" 0 ${_eq} _url)
    math(EXPR _start "${_eq} + 1")
    string(SUBSTRING "${_pair}" ${_start} -1 _file)
    file(SIZE "${_file}" _size)
    file(READ "${_file}" _hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(APPEND _arrays "inline constexpr std::array<std::uint8_t, ${_size}> kAsset${_index} = {${_bytes}};\n")
    string(APPEND _entries "    Asset{\"${_url}\", std::span<const std::uint8_t>(kAsset${_index})},\n")
    math(EXPR _index "${_index} + 1")
endforeach()
set(_content "// Generated by examples/terminal_demo/embed_assets.cmake. Do not edit.
#pragma once
#include <array>
#include <cstdint>
#include <span>
#include <string_view>

namespace boson::terminal_demo {

struct Asset {
    std::string_view path;
    std::span<const std::uint8_t> data;
};

${_arrays}
inline constexpr std::array<Asset, ${_index}> kAssets = {{
${_entries}}};

} // namespace boson::terminal_demo
")
file(WRITE "${OUT}" "${_content}")
