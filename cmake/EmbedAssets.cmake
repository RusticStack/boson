include_guard(GLOBAL)

set(BOSON_FRONTEND_DIST_DIR "${CMAKE_SOURCE_DIR}/frontend/dist")
set(BOSON_GENERATED_DIR "${CMAKE_BINARY_DIR}/generated")
set(BOSON_EMBEDDED_HEADER "${BOSON_GENERATED_DIR}/boson_embedded_assets.hpp")

file(MAKE_DIRECTORY "${BOSON_GENERATED_DIR}")

set(_boson_asset_arrays "")
set(_boson_asset_entries "")
set(_boson_asset_index 0)

if(EXISTS "${BOSON_FRONTEND_DIST_DIR}" AND IS_DIRECTORY "${BOSON_FRONTEND_DIST_DIR}")
    file(GLOB_RECURSE _boson_dist_files
        CONFIGURE_DEPENDS
        LIST_DIRECTORIES FALSE
        "${BOSON_FRONTEND_DIST_DIR}/*"
    )
else()
    set(_boson_dist_files "")
endif()

if(_boson_dist_files)
    list(SORT _boson_dist_files)
    foreach(_asset_file IN LISTS _boson_dist_files)
        file(RELATIVE_PATH _rel_path "${BOSON_FRONTEND_DIST_DIR}" "${_asset_file}")
        string(REPLACE "\\" "/" _rel_path "${_rel_path}")
        set(_url_path "/${_rel_path}")

        file(SIZE "${_asset_file}" _file_size)
        if(_file_size GREATER 0)
            file(READ "${_asset_file}" _hex_content HEX)
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _byte_list "${_hex_content}")
            string(REGEX REPLACE ",$" "" _byte_list "${_byte_list}")
        else()
            set(_byte_list "")
        endif()

        set(_var_name "kAssetData_${_boson_asset_index}")
        if(_file_size GREATER 0)
            string(APPEND _boson_asset_arrays
                "inline constexpr std::array<std::uint8_t, ${_file_size}> ${_var_name} = { ${_byte_list} };\n"
            )
            string(APPEND _boson_asset_entries
                "    EmbeddedAssetEntry{ \"${_url_path}\", std::span<const std::uint8_t>{${_var_name}.data(), ${_var_name}.size()} },\n"
            )
        else()
            string(APPEND _boson_asset_entries
                "    EmbeddedAssetEntry{ \"${_url_path}\", std::span<const std::uint8_t>{} },\n"
            )
        endif()

        math(EXPR _boson_asset_index "${_boson_asset_index} + 1")
    endforeach()
else()
    # Minimal placeholder index.html so configure/build succeeds before frontend/dist is built.
    set(_placeholder_html "<!doctype html><html><head><meta charset=\"utf-8\"><title>Boson</title></head><body><h1>Boson Placeholder</h1><p>Build frontend/dist to embed production assets.</p></body></html>")
    string(LENGTH "${_placeholder_html}" _placeholder_len)
    string(HEX "${_placeholder_html}" _placeholder_hex)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _placeholder_bytes "${_placeholder_hex}")
    string(REGEX REPLACE ",$" "" _placeholder_bytes "${_placeholder_bytes}")

    set(_boson_asset_arrays
        "inline constexpr std::array<std::uint8_t, ${_placeholder_len}> kAssetData_0 = { ${_placeholder_bytes} };\n"
    )
    set(_boson_asset_entries
        "    EmbeddedAssetEntry{ \"/index.html\", std::span<const std::uint8_t>{kAssetData_0.data(), kAssetData_0.size()} },\n"
    )
    set(_boson_asset_index 1)
endif()

set(_boson_header_content
"// Auto-generated by cmake/EmbedAssets.cmake. Do not edit manually.
#pragma once

#include <array>
#include <cstdint>
#include <span>
#include <string_view>

namespace boson::assets::generated {

struct EmbeddedAssetEntry {
    std::string_view path;
    std::span<const std::uint8_t> data;
};

${_boson_asset_arrays}
inline constexpr std::array<EmbeddedAssetEntry, ${_boson_asset_index}> kEmbeddedAssets = {{
${_boson_asset_entries}}};

} // namespace boson::assets::generated
")

set(_write_header TRUE)
if(EXISTS "${BOSON_EMBEDDED_HEADER}")
    file(READ "${BOSON_EMBEDDED_HEADER}" _existing_content)
    if(_existing_content STREQUAL _boson_header_content)
        set(_write_header FALSE)
    endif()
endif()

if(_write_header)
    file(WRITE "${BOSON_EMBEDDED_HEADER}" "${_boson_header_content}")
    message(STATUS "Generated ${BOSON_EMBEDDED_HEADER} with ${_boson_asset_index} embedded asset(s).")
endif()
