# CPACK_POST_BUILD_SCRIPTS hook: signs the .msi / .exe / .msix packages CPack just produced, using the
# signing settings boson_package() copied into CPACK_BOSON_SIGN_* variables.
if(NOT CPACK_BOSON_SIGN)
    return()
endif()
set(_files "")
foreach(_pkg IN LISTS CPACK_PACKAGE_FILES)
    if(_pkg MATCHES "\\.(msi|exe|msix)$")
        list(APPEND _files "${_pkg}")
    endif()
endforeach()
if(NOT _files)
    return()
endif()
set(BOSON_SIGNTOOL "${CPACK_BOSON_SIGNTOOL}")
set(BOSON_SIGN_FILES "${_files}")
set(BOSON_SIGN_THUMBPRINT "${CPACK_BOSON_SIGN_THUMBPRINT}")
set(BOSON_SIGN_CERT_STORE "${CPACK_BOSON_SIGN_CERT_STORE}")
set(BOSON_SIGN_MACHINE_STORE "${CPACK_BOSON_SIGN_MACHINE_STORE}")
set(BOSON_SIGN_PFX "${CPACK_BOSON_SIGN_PFX}")
set(BOSON_SIGN_PFX_PASSWORD_ENV "${CPACK_BOSON_SIGN_PFX_PASSWORD_ENV}")
set(BOSON_SIGN_DLIB "${CPACK_BOSON_SIGN_DLIB}")
set(BOSON_SIGN_DLIB_METADATA "${CPACK_BOSON_SIGN_DLIB_METADATA}")
set(BOSON_SIGN_TIMESTAMP_URL "${CPACK_BOSON_SIGN_TIMESTAMP_URL}")
set(BOSON_SIGN_DESCRIPTION "${CPACK_BOSON_SIGN_DESCRIPTION}")
include("${CPACK_BOSON_SIGN_SCRIPT}")
