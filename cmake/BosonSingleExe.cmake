include_guard(GLOBAL)

# boson_single_exe(<target> [EMBED_BOOTSTRAPPER])
#
# Marks <target> as a self-contained single executable and checks it:
#   * requires -DBOSON_SINGLE_EXE=ON (static CRT for the whole tree; WebView2 loader, glaze, stdexec, miniz,
#     SQLite and ZephyrDB are static libraries already; frontend assets are compiled into the exe),
#   * registers the ctest "<target>_single_exe_deps": every DLL the produced exe imports must be on the
#     allow-list of Windows system DLLs in cmake/BosonCheckDependents.cmake (the check runs on the final file).
#   * EMBED_BOOTSTRAPPER also compiles Microsoft's Evergreen WebView2 bootstrapper (MicrosoftEdgeWebview2Setup.exe,
#     ~1.7 MiB) into the exe: target gets BOSON_EMBED_WEBVIEW2_BOOTSTRAPPER=1 and
#     #include <boson_webview2_bootstrapper.hpp> provides boson::shipping::embedded_bootstrapper(); pass it to
#     boson::shipping::require_webview2_runtime(). The file is fetched at configure time (or taken from
#     -DBOSON_WEBVIEW2_BOOTSTRAPPER_FILE=<path>) and Authenticode-verified again at run time before it is started.
function(boson_single_exe target)
    cmake_parse_arguments(ARG "EMBED_BOOTSTRAPPER" "" "" ${ARGN})
    if(NOT TARGET ${target})
        message(FATAL_ERROR "boson_single_exe: '${target}' is not a target")
    endif()
    if(NOT BOSON_SINGLE_EXE)
        message(FATAL_ERROR "boson_single_exe(${target}): configure with -DBOSON_SINGLE_EXE=ON (static CRT for the whole build)")
    endif()
    if(NOT MSVC)
        message(FATAL_ERROR "boson_single_exe: MSVC only")
    endif()

    get_filename_component(_boson_linker_dir "${CMAKE_LINKER}" DIRECTORY)
    find_program(BOSON_DUMPBIN dumpbin HINTS "${_boson_linker_dir}" REQUIRED)
    add_test(NAME ${target}_single_exe_deps
        COMMAND ${CMAKE_COMMAND}
            -DEXE=$<TARGET_FILE:${target}>
            -DDUMPBIN=${BOSON_DUMPBIN}
            -P "${PROJECT_SOURCE_DIR}/cmake/BosonCheckDependents.cmake")

    if(ARG_EMBED_BOOTSTRAPPER)
        boson_embed_webview2_bootstrapper()
        target_compile_definitions(${target} PRIVATE BOSON_EMBED_WEBVIEW2_BOOTSTRAPPER=1)
        add_dependencies(${target} boson_webview2_bootstrapper_header)
    endif()
endfunction()

# Generates <build>/generated/boson_webview2_bootstrapper.hpp once per configure tree.
function(boson_embed_webview2_bootstrapper)
    if(TARGET boson_webview2_bootstrapper_header)
        return()
    endif()
    set(_dir "${BOSON_WEBVIEW2_ROOT}")
    set(_exe "${BOSON_WEBVIEW2_BOOTSTRAPPER_FILE}")
    if(NOT _exe)
        set(_exe "${_dir}/MicrosoftEdgeWebview2Setup.exe")
        if(NOT EXISTS "${_exe}")
            message(STATUS "Downloading the WebView2 Evergreen bootstrapper...")
            file(DOWNLOAD "https://go.microsoft.com/fwlink/p/?LinkId=2124703" "${_exe}" STATUS _st TLS_VERIFY ON)
            list(GET _st 0 _code)
            if(NOT _code EQUAL 0)
                file(REMOVE "${_exe}")
                message(FATAL_ERROR "Cannot download the WebView2 bootstrapper (${_st}); pass -DBOSON_WEBVIEW2_BOOTSTRAPPER_FILE=<path>")
            endif()
        endif()
    endif()
    file(SIZE "${_exe}" _size)
    file(SHA256 "${_exe}" _sha)
    set(_header "${BOSON_GENERATED_DIR}/boson_webview2_bootstrapper.hpp")
    set(_stamp "${BOSON_GENERATED_DIR}/boson_webview2_bootstrapper.sha256")
    set(_old "")
    if(EXISTS "${_stamp}" AND EXISTS "${_header}")
        file(READ "${_stamp}" _old)
    endif()
    if(NOT _old STREQUAL "${_sha}")
        file(READ "${_exe}" _hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
        file(WRITE "${_header}" "// Auto-generated by cmake/BosonSingleExe.cmake from MicrosoftEdgeWebview2Setup.exe (SHA-256 ${_sha}).
#pragma once
#include <array>
#include <cstddef>
#include <cstdint>
#include <span>
namespace boson::shipping {
inline constexpr std::array<std::uint8_t, ${_size}> kBootstrapperBytes = {
${_bytes}
};
[[nodiscard]] inline std::span<const std::byte> embedded_bootstrapper() noexcept {
    return std::as_bytes(std::span{kBootstrapperBytes});
}
} // namespace boson::shipping
")
        file(WRITE "${_stamp}" "${_sha}")
    endif()
    add_custom_target(boson_webview2_bootstrapper_header DEPENDS "${_header}")
    message(STATUS "Embedding WebView2 bootstrapper (${_size} bytes, sha256 ${_sha})")
endfunction()
