<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by boson_package(): Start-menu shortcut with AppUserModelID, URL protocols, uninstall cleanup. -->
<Wix xmlns="@BOSON_WIX_NS@"@BOSON_WIX_UTIL_NS_ATTR@>
  <Fragment>
@BOSON_WIX_PROGRAM_MENU_DECL@
@BOSON_WIX_APPDATA_PROPERTY@
    <ComponentGroup Id="BosonAppIntegration">
      <Component Id="BosonStartMenuShortcut" Directory="ProgramMenuFolder" Guid="@BOSON_WIX_GUID_SHORTCUT@">
        <Shortcut Id="BosonAppShortcut" Name="@BOSON_PKG_NAME_XML@" Description="@BOSON_PKG_DESCRIPTION_XML@"
                  Target="[INSTALL_ROOT]@BOSON_PKG_EXE@" WorkingDirectory="INSTALL_ROOT">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="@BOSON_PKG_AUMID@" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\@BOSON_PKG_REG_KEY@" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="BosonUninstallCleanup" Directory="INSTALL_ROOT" Guid="@BOSON_WIX_GUID_CLEANUP@">
        <RegistryValue Root="HKCU" Key="Software\@BOSON_PKG_REG_KEY@" Name="InstallDir" Type="string" Value="[INSTALL_ROOT]" KeyPath="yes" />
@BOSON_WIX_APPDATA_COMPONENT@        <RemoveRegistryKey Root="HKCU" Key="Software\@BOSON_PKG_REG_KEY@" Action="removeOnUninstall" />
        <!-- Files the app or its updater may create next to the executable. -->
        <RemoveFile Id="BosonRemoveLogs" Directory="INSTALL_ROOT" Name="*.log" On="uninstall" />
        <RemoveFolder Id="BosonRemoveInstallRoot" Directory="INSTALL_ROOT" On="uninstall" />
      </Component>
@BOSON_WIX_PROTOCOL_COMPONENTS@    </ComponentGroup>
  </Fragment>
</Wix>
